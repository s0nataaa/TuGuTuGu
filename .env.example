# ---- Supabase (wajib) ----
# Dashboard Supabase -> Project Settings -> API
# Dua nilai ini AMAN ada di browser (anon key dibatasi oleh Row Level Security).
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-ANON-PUBLIC-KEY"

# ---- JANGAN diberi prefix VITE_ dan JANGAN di-commit ----
# service_role key mem-bypass RLS. Hanya untuk server (Supabase Edge Function
# sudah mendapatkannya otomatis sebagai env SUPABASE_SERVICE_ROLE_KEY).
# SUPABASE_SERVICE_ROLE_KEY=
